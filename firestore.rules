rules_version = '2';

// Express Emlak - Firestore güvenlik kuralları
//
// ÖNEMLİ: Bu dosya sürüm kontrolü içindir. Firebase bu dosyayı kendiliğinden
// okumaz; değişiklikten sonra Firebase Console > Firestore Database > Rules
// ekranına yapıştırıp "Yayınla" demek gerekir.
//
// Yetkilendirme burada sunucu tarafında yapılır. admin.html'deki
// ALLOWED_EMAILS kontrolü yalnızca arayüz kolaylığıdır; gerçek koruma bu kurallardır.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUploader() {
      return request.auth != null
        && request.auth.token.email in [
          "osmangundemir1@gmail.com",
          "expressinsaatgayrimenkul@gmail.com",
          "ab.sametdundar@gmail.com",
          "ipekcimipek@gmail.com"
        ];
    }

    // Ziyaretçi bir ilanı açtığında goruntulenmeSayisi alanını 1 artırabilir -
    // kimliksiz, ama YALNIZCA bu iki alanı (sayaç + zaman damgası) değiştirebilir
    // ve değer tam olarak eskisi+1 olmalı (rastgele büyük bir sayıya atlayamaz).
    // Başka herhangi bir alana dokunan istek reddedilir - bu yüzden aynı
    // yetkisiz kullanıcı fiyatı/açıklamayı değiştiremez, yalnızca sayacı ilerletebilir.
    //
    // Sunucu tarafı hız sınırlaması: istemcideki sessionStorage kontrolü (10sn
    // bekleme) tarayıcı konsolundan veya doğrudan API çağrısıyla atlatılabilir -
    // bu yüzden gerçek koruma burada. goruntulenmeSonZaman alanı her artışta
    // request.time'a (sunucu saati, istemci taklit edemez) güncellenmek ZORUNDA;
    // bir önceki güncellemeden bu yana en az 10 saniye geçmediyse istek reddedilir.
    function sadeceGoruntulenmeArtisi() {
      let eskiSayi = resource.data.get('goruntulenmeSayisi', 0);
      let sonZaman = resource.data.get('goruntulenmeSonZaman', timestamp.value(0));
      let beklemeGecti = request.time > sonZaman + duration.value(10, 's');
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['goruntulenmeSayisi', 'goruntulenmeSonZaman'])
        && request.resource.data.goruntulenmeSayisi == eskiSayi + 1
        && request.resource.data.goruntulenmeSonZaman == request.time
        && beklemeGecti;
    }

    // İlanlar: herkes okur (site ziyaretçileri), yalnızca yetkili yazar.
    match /ilanlar/{ilanId} {
      allow read: if true;

      // Yeni ilan oluşturma
      allow create: if isAllowedUploader();

      // Güncelleme: yetkili kullanıcı her şeyi değiştirebilir; kimliksiz
      // ziyaretçi yalnızca görüntülenme sayacını 1 artırabilir.
      allow update: if isAllowedUploader() || sadeceGoruntulenmeArtisi();

      allow delete: if isAllowedUploader();
    }

    // Site ayarları (Express Konut ödeme planları vb.):
    // herkes okur çünkü express-konut.html ve index.html bu veriyi gösterir;
    // yalnızca yetkili yazar çünkü panelden düzenlenir.
    match /ayarlar/{ayarId} {
      allow read: if true;
      allow create, update, delete: if isAllowedUploader();
    }

    // Yetki kontrolü: admin.js girişten hemen sonra buraya zararsız bir
    // yazma dener. Üretimde ALLOWED_EMAILS gizlendiği (bkz. admin-config.js)
    // için arayüz her giriş yapan kullanıcıyı geçici olarak "yetkili" sayar;
    // bu kural gerçek sunucu tarafı kontrolü sağlar, kullanıcı formu
    // doldurmadan yetkisiz olduğunu öğrenir. Kimse okumaz, veri önemsizdir.
    match /yetkiKontrol/{uid} {
      allow read: if false;
      allow write: if isAllowedUploader();
    }

    // Yukarıda açıkça izin verilmeyen her yol kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
